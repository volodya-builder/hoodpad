{
  "rules": {
    ".read": false,
    ".write": false,

    "chats": {
      ".read": true,
      "$room": {
        ".indexOn": ["ts"],
        "$msg": {
          ".write": "!data.exists() && $room.matches(/^0x[0-9a-f]{40}$/) && $msg.matches(/^-[A-Za-z0-9_-]{19}$/)",
          ".validate": "newData.hasChildren(['who', 'text', 'ts'])",
          "who":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 42" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 280" },
          "ts":   { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 300000" },
          "w":    { ".validate": "newData.isNumber() && (newData.val() == 0 || newData.val() == 1)" },
          "$other": { ".validate": false }
        }
      }
    },

    "bans": {
      ".read": true,
      "$ts": {
        ".write": "!data.exists() && $ts.matches(/^[0-9]{13}$/)",
        ".validate": "newData.hasChildren(['p', 's'])",
        "p": { ".validate": "newData.isString() && newData.val().length < 20000" },
        "s": { ".validate": "newData.isString() && newData.val().matches(/^0x[0-9a-fA-F]{130}$/)" },
        "$other": { ".validate": false }
      }
    },

    "presence": {
      ".read": true,
      "$pid": {
        ".write": "$pid.matches(/^[a-z0-9]{1,16}$/) && (newData.exists() || !data.exists() || data.child('ts').val() < now - 3600000)",
        ".validate": "newData.hasChildren(['ts'])",
        "ts": { ".validate": "newData.isNumber() && newData.val() <= now + 300000 && newData.val() >= now - 300000" },
        "w":  { ".validate": "newData.isNumber() && (newData.val() == 0 || newData.val() == 1)" },
        "$other": { ".validate": false }
      }
    },

    "activity": {
      ".read": true,
      "$slot": {
        ".write": "$slot.matches(/^[0-9]{1,12}$/) && !newData.exists() && (!data.hasChild('b') || data.child('b').val() < now / 300000 - 8928)",
        "b": {
          ".write": "$slot.matches(/^[0-9]{1,12}$/) && (!data.exists() || newData.val() == data.val())",
          ".validate": "newData.isNumber()"
        },
        "p": {
          "$pid": {
            ".write": "$slot.matches(/^[0-9]{1,12}$/) && $pid.matches(/^[a-z0-9]{1,16}$/) && (!data.exists() || newData.val() == 2)",
            ".validate": "newData.val() == 1 || newData.val() == 2"
          }
        },
        "$other": { ".validate": false }
      }
    },

    "revenue_waitlist": {
      ".read": false,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['svc', 'contact', 'ts'])",
        "svc":     { ".validate": "newData.isString() && newData.val().length <= 80" },
        "contact": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "ts":      { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other":  { ".validate": false }
      }
    },

    "aichat": {
      ".read": true,
      "$coin": {
        "messages": { ".write": false },
        "stats":    { ".write": false }
      }
    },

    "profiles": {
      ".read": true,
      "$addr": {
        "$ts": {
          ".write": "!data.exists() && $addr.matches(/^0x[0-9a-f]{40}$/) && $ts.matches(/^[0-9]{13}$/)",
          ".validate": "newData.hasChildren(['p', 's'])",
          "p": { ".validate": "newData.isString() && newData.val().length < 70000" },
          "s": { ".validate": "newData.isString() && newData.val().matches(/^0x[0-9a-fA-F]{130}$/)" },
          "$other": { ".validate": false }
        }
      }
    },

    "workshop": {
      ".read": true,
      ".write": false
    }
  }
}
