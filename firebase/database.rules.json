{
  "//": "ПРАВИЛА БЕЗОПАСНОСТИ Firebase RTDB для hood. Загрузить: Firebase Console → Realtime Database → Rules → вставить → Publish. БЕЗ НИХ база открыта на запись всему интернету: любой может стереть чат, снять свой бан, забанить владельца, накрутить онлайн и сжечь биллинг.",

  "rules": {
    ".read": false,
    ".write": false,

    "chats": {
      "$room": {
        ".read": true,
        ".validate": "$room.matches(/^0x[0-9a-fA-F]{40}$/)",
        "$msg": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['who','text','ts']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 280 && newData.child('who').isString() && newData.child('who').val().length <= 42 && newData.child('ts').val() === now",
          "$other": { ".validate": false }
        }
      }
    },

    "bans": {
      ".read": true,
      ".write": false,
      "//": "снимать/ставить баны — только из админ-скрипта с database secret"
    },

    "presence": {
      ".read": false,
      "$pid": {
        ".read": true,
        ".write": true,
        ".validate": "$pid.length <= 32 && newData.hasChild('ts') && newData.child('ts').val() <= now && newData.child('ts').val() > now - 120000",
        "$other": { ".validate": false }
      }
    },

    "visitors": {
      ".read": false,
      "//": "содержит связку браузер↔кошелёк — читать посторонним нельзя",
      "$pid": {
        ".write": "!data.exists() || (newData.child('first').val() === data.child('first').val())",
        ".validate": "$pid.length <= 32 && newData.child('last').val() <= now",
        "first": { ".validate": "newData.isNumber()" },
        "last": { ".validate": "newData.isNumber()" },
        "w": { ".validate": "newData.isNumber()" },
        "addr": { ".validate": "newData.isString() && newData.val().matches(/^0x[0-9a-fA-F]{40}$/)" },
        "$other": { ".validate": false }
      }
    },

    "activity": {
      ".read": true,
      "$slot": {
        ".write": true,
        ".validate": "$slot.matches(/^([0-9]|1[01])$/)",
        "b": { ".validate": "newData.isNumber()" },
        "p": { "$pid": { ".validate": "$pid.length <= 32" } },
        "$other": { ".validate": false }
      }
    },

    "referrals": {
      ".read": true,
      "$trader": {
        ".write": "!data.exists()",
        "//": "привязка создаётся один раз и не переписывается — иначе можно угнать чужих рефералов",
        ".validate": "$trader.matches(/^0x[0-9a-fA-F]{40}$/) && newData.hasChildren(['ref','ts']) && newData.child('ref').isString() && newData.child('ref').val().matches(/^0x[0-9a-fA-F]{40}$/) && newData.child('ref').val().toLowerCase() !== $trader.toLowerCase() && newData.child('ts').val() === now",
        "$other": { ".validate": false }
      }
    },

    "referralPayouts": {
      ".read": true,
      ".write": false,
      "//": "реестр выплат пишет только скрипт с database secret"
    }
  }
}
