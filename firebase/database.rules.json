{
  "rules": {
    ".read": false,
    ".write": false,
    "chats": {
      ".read": true,
      "$room": {
        "$msg": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['who','text','ts']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 280 && newData.child('who').isString() && newData.child('who').val().length <= 42 && newData.child('ts').val() <= now"
        }
      }
    },
    "bans": {
      ".read": true,
      ".write": false
    },
    "presence": {
      ".read": true,
      "$pid": {
        ".write": true,
        ".validate": "newData.hasChild('ts') && newData.child('ts').val() <= now + 300000"
      }
    },
    "visitors": {
      ".read": false,
      "$pid": {
        ".write": true
      }
    },
    "activity": {
      ".read": true,
      "$slot": {
        ".write": true
      }
    },
    "revenue_waitlist": {
      ".read": false,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['svc','contact','ts']) && newData.child('svc').isString() && newData.child('svc').val().length <= 80 && newData.child('contact').isString() && newData.child('contact').val().length <= 120 && newData.child('ts').val() <= now"
      }
    },
    "aichat": {
      ".read": true,
      "$coin": {
        "messages": {
          ".write": false
        },
        "stats": {
          ".write": false
        }
      }
    },
    "workshop": {
      ".read": true,
      "board": {
        "$token": {
          ".write": true
        }
      },
      "proposals": {
        "$token": {
          ".write": true
        }
      },
      "votes": {
        "$token": {
          ".write": true
        }
      },
      "journal": {
        "$token": {
          ".write": true
        }
      },
      "agent": {
        "heartbeat": {
          ".write": true,
          ".validate": "newData.hasChildren(['at','state']) && newData.child('at').val() <= now + 60000 && newData.child('state').isString()"
        }
      }
    }
  }
}
